# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# Required for the toy agent and the Anthropic judge (M2 onward).
ANTHROPIC_API_KEY=

# Optional: judge model override (default claude-sonnet-5-5 from evals/suite.yaml).
CASEGATE_JUDGE_MODEL=

# Optional: OpenAI-compatible judge (provider: openai in suite.yaml).
OPENAI_API_KEY=
CASEGATE_JUDGE_BASE_URL=

# Optional: price table override, path to JSON {"model": [input_per_1m, output_per_1m]}.
CASEGATE_PRICES=

# Optional: run tests that call the real API (costs money, about $0.01).
CASEGATE_LIVE=
